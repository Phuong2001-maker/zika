{
  "name": "zika/app",
  "description": "Zìkǎ — API PHP thuần cho web học tiếng Trung theo HSK",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.4",
    "ext-curl": "*",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-intl": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "firebase/php-jwt": "^7.2",
    "phpmailer/phpmailer": "^7.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^12.0"
  },
  "autoload": {
    "psr-4": { "Zika\\": "src/" }
  },
  "autoload-dev": {
    "psr-4": { "Zika\\Tests\\": "../tests/" }
  },
  "config": {
    "platform": { "php": "8.4.0" },
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
