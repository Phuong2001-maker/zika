# <DOCROOT>/uploads/.htaccess — không bao giờ chạy script trong thư mục tải lên (02 §6.4)
Options -Indexes
<FilesMatch "\.(php|phtml|phar|pl|py|cgi|sh)$">
  Require all denied
</FilesMatch>
<IfModule mod_php.c>
  php_flag engine off
</IfModule>
<IfModule mod_headers.c>
  Header set Cache-Control "public, max-age=2592000"
  Header set X-Content-Type-Options "nosniff"
</IfModule>
